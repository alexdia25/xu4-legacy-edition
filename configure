#!/bin/bash

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Configuration Options:"
  echo "  -h, --help        Display this help and exit"
  echo "  --gpu             Use GPU for rendering (experimental)"
  echo "  --prefix <dir>    Set install directory root"
  exit
fi

PLATFORM=sdl3
PREFIX=/usr/local
GPU=scale

while [ "$1" != "" ]; do
  case $1 in
    --sdl3)
      ;;    # SDL3 is the only platform API; accepted for old scripts.
    --gpu)
      GPU=all ;;
    --prefix)
      shift
      PREFIX=$1 ;;
    *)
      echo "Invalid option $1"
      exit 1
      ;;
  esac
  shift
done

echo "Generating make.config"
printf "PREFIX=${PREFIX}\nUI=${PLATFORM}\nGPU=${GPU}\n" >make.config
echo "Now type make to build."
