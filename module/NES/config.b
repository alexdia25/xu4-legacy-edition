module [
    about: {{
        Ultima IV with the graphics of the NES release, Ultima: Quest of the
        Avatar: its map tiles, characters, monsters and font.  Requires the
        ROM of the NES game (.nes) in the xu4 data folder, next to the DOS
        game files.
    }}
    author: "XU4 Legacy Edition"
    version: "0.1"
    rules: "Ultima-IV/1.4"
    requires: "nes"
]

include %graphics.b
