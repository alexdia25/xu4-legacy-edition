module [
    about: {{
        Ultima IV with the graphics of the original Commodore 64 release.
        Requires the Program disk image (.d64) of Ultima IV for the C64 in
        the xu4 data folder, next to the DOS game files.
    }}
    author: "XU4 Legacy Edition"
    version: "0.1"
    rules: "Ultima-IV/1.4"
    requires: "c64"
]

include %graphics.b
