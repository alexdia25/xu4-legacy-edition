module [
    about: {{
        Ultima IV with the CGA graphics of the DOS release: the four colour
        map tiles, font and pictures, read from the game's own SHAPES.CGA,
        CHARSET.CGA and .PIC files.
    }}
    author: "XU4 Legacy Edition"
    version: "0.1"
    rules: "Ultima-IV/1.4"
    requires: "cga"
]

include %graphics.b
