module [
    about: {{
        Ultima IV with the graphics of the original Apple II release.
        Requires the four Ultima IV Apple II disk images (.dsk) in the
        xu4 data folder, next to the DOS game files.
    }}
    author: "XU4 Legacy Edition"
    version: "0.1"
    rules: "Ultima-IV/1.4"
    requires: "apple2"
]

include %graphics.b
