module [
    about: {{
        Ultima IV with the graphics of the Sega Master System release:
        its map tiles, font and story pictures.  Requires the ROM of
        Ultima IV: Quest of the Avatar for the Master System (.sms) in the
        xu4 data folder, next to the DOS game files.
    }}
    author: "XU4 Legacy Edition"
    version: "0.1"
    rules: "Ultima-IV/1.4"
    requires: "sms"
]

include %graphics.b
